          "expr": "{job=\"containerlogs\"} | json | __error__=\"\" != \"metrics\" != \"executing query\" != \"component=querier\" != \"error processing request\" != \"caller=retry.go\" != \"org_id=fake\" != \"downloaded file\" != \"checkpoint\" != \"component=tsdb\" != \"table-name=\" != \"compactor\" != \"WAL checkpoint\" | event=~\"http_request_.*\"",
