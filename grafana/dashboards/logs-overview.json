{
  "id": null,
  "uid": "ecommerce-logs-overview",
  "title": "Logs Overview",
  "tags": ["logs", "ecommerce-api"],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "",
