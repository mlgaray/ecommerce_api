    {
      "id": 6,
      "title": "Log Count by Level (24h)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (level) (count_over_time({job=\"containerlogs\"} | json | __error__=\"\" != \"metrics\" != \"executing query\" != \"component=querier\" != \"error processing request\" != \"caller=retry.go\" != \"org_id=fake\" != \"downloaded file\" != \"checkpoint\" != \"component=tsdb\" != \"table-name=\" != \"compactor\" != \"WAL checkpoint\" [24h])))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "level": "Log Level",
              "Value": "Count"
            }
          }
        }
      ]
    },
