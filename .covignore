internal/infraestructure/adapters/http/

# Server setup - configuration, routing
internal/infraestructure/server/

# Logs adapter - external dependency wrapper
internal/infraestructure/adapters/logs/

# Auth adapter - JWT wrapper
internal/infraestructure/adapters/auth/
