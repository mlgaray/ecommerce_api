# Mocks - auto-generated files
mocks/

# Integration tests - not unit tests
tests/integration/

# Entry point - minimal logic, DI setup
main.go

# Infrastructure adapters - DB access, external services (hard to unit test)
internal/infraestructure/adapters/repositories/

